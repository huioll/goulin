# 复制本文件为 .env，填入真实值。.env 已在 .gitignore 中，不会被提交。
#
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env

# ---- 大模型接口（OpenAI 兼容）----
WORKBUDDY_API_KEY=sk-your-key-here
WORKBUDDY_BASE_URL=https://api.deepseek.com/v1
WORKBUDDY_MODEL=deepseek-chat

# ---- MySQL ----
# 只列出需要覆盖的项；host/port/user/database 不填则用 harness/config.py 里的默认值
# 用 docker compose 起库时，这个值会同时作为 MySQL 的 root 密码（compose 自动读本文件）
MYSQL_PASSWORD=your-mysql-password

# ---- 可选：改运行产物位置 ----
# HARNESS_DATA_DIR=./data
# HARNESS_LOG_DIR=./logs
# HARNESS_DB=./data/harness.db
